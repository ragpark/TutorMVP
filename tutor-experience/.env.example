# Copy to .env and fill in. Never commit .env.
MAP_BASE_URL=https://h2-app-production.up.railway.app
ANTHROPIC_API_KEY=
# Shared secret the map's evaluation harness sends in X-Tutor-Secret. Leave empty to accept unsigned calls.
TUTOR_SECRET=
MODEL=claude-sonnet-4-5

# Optional
# Write answers back to the map on harness turns in the h2 condition (default off).
EVIDENCE_FROM_HARNESS=false
# Seconds the webhook allows for a whole turn before giving up (harness timeout is 60).
WEBHOOK_BUDGET_S=50
# Where turn logs and transcripts are written.
DATA_DIR=./data
# Public URL of this deployment, used by `make register`.
TUTOR_PUBLIC_URL=
